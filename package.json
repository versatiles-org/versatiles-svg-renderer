{
  "name": "versatiles-svg-renderer",
  "version": "2.0.0",
  "private": true,
  "description": "Monorepo of @versatiles/svg-renderer, @versatiles/png-renderer and @versatiles/maplibre-svg-export.",
  "homepage": "https://github.com/versatiles-org/versatiles-svg-renderer",
  "bugs": "https://github.com/versatiles-org/versatiles-svg-renderer/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/versatiles-org/versatiles-svg-renderer.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "bench": "tsx --expose-gc bench/bench.ts",
    "build": "rm -rf packages/*/dist && rollup -c rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "build:browser-tarball": "mkdir -p release && COPYFILE_DISABLE=1 tar -czf release/maplibre-svg-export.tar.gz -C packages/maplibre-svg-export/dist maplibre-svg-export.js maplibre-svg-export.umd.min.js maplibre-svg-export.d.ts -C .. README.md LICENSE",
    "check": "npm run format && npm run lint && npm run typecheck && npm run build && npm run test && npm run test:pack && npm run test:e2e",
    "demo": "tsx scripts/demo.ts",
    "dev": "tsx dev/serve.ts",
    "dev:render-comparison": "tsx dev/render-comparison.ts",
    "doc:typescript": "npx vrt doc-typescript -f html -i ./docs.ts -o ./doc-typescript",
    "docs": "npm run build && npm run docs --workspaces",
    "format": "prettier --write --log-level warn .",
    "lint": "eslint --color .",
    "profile": "tsx bench/profile.ts",
    "release": "tsx scripts/release.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts && npm run test:e2e:maplibre && npm run test:e2e:screenshots",
    "test:e2e:maplibre": "tsx e2e/maplibre-control.ts",
    "test:e2e:screenshots": "tsx e2e/screenshots.ts",
    "test:pack": "tsx scripts/pack-test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json && tsc --noEmit -p dev/tsconfig.json && tsc --noEmit -p bench/tsconfig.json",
    "upgrade": "ncu --upgrade --workspaces --no-root && vrt deps-upgrade"
  },
  "type": "module",
  "author": "Michael Kreil <versatiles@michael-kreil.de>",
  "license": "MIT",
  "engines": {
    "node": ">= 22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/noto-sans": "^5.3.0",
    "@mapbox/vector-tile": "^3.0.0",
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@napi-rs/canvas": "^1.0.9",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.6.2",
    "@types/pbf": "^3.0.5",
    "@types/pngjs": "^6.0.5",
    "@versatiles/release-tool": "^2.17.0",
    "@versatiles/style": "^6.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "geojson": "^0.5.0",
    "jsdom": "^30.1.1",
    "maplibre-gl": "^6.10.0",
    "npm-check-updates": "^23.1.0",
    "pbf": "^5.1.2",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.8",
    "rollup": "^4.63.4",
    "rollup-plugin-dts": "^6.5.1",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
